<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="20.0" prefWidth="300.0" prefHeight="380.0"
      style="-fx-background-color: #1e1e1e;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.ProfileController">
    <padding><Insets bottom="30.0" left="30.0" right="30.0" top="30.0"/></padding>

    <Label text="Профиль" style="-fx-text-fill: white; -fx-font-size: 20; -fx-font-weight: bold;"/>

    <StackPane maxWidth="90" maxHeight="90" minWidth="90" minHeight="90"
               style="-fx-background-color: #333; -fx-background-radius: 45;">
        <Label text="*" style="-fx-font-size: 44; -fx-text-fill: #888;"/>
    </StackPane>

    <VBox spacing="4" alignment="CENTER">
        <Label text="Ваш логин" style="-fx-text-fill: #888; -fx-font-size: 12;"/>
        <Label fx:id="loginLabel" text="Username"
               style="-fx-text-fill: #4da6ff; -fx-font-size: 22; -fx-font-weight: bold;"/>
    </VBox>

    <Button text="Закрыть" onAction="#onCloseClick" styleClass="btn-secondary" prefWidth="120" prefHeight="36"/>
</VBox>
