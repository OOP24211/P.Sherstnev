<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<HBox prefHeight="620.0" prefWidth="960.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.MainController">
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>

    <!-- ═══ ЛЕВАЯ ПАНЕЛЬ — список чатов ═══ -->
    <VBox prefWidth="300.0" minWidth="260.0"
          style="-fx-border-color: #333; -fx-border-width: 0 1 0 0; -fx-background-color: #1a1a1a;">
        <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

        <TextField fx:id="searchField"
                   promptText="🔍  Поиск чатов и людей..."
                   styleClass="text-field"/>

        <StackPane VBox.vgrow="ALWAYS">
            <VBox.margin><Insets top="8"/></VBox.margin>
            <ListView fx:id="chatListView"/>
            <ListView fx:id="searchResultsList" visible="false" managed="false"/>
        </StackPane>

        <!-- Нижняя панель левой колонки -->
        <HBox spacing="8" alignment="CENTER" prefHeight="55.0" minHeight="55.0">
            <VBox.margin><Insets top="8"/></VBox.margin>
            <Button text="＋" onAction="#onCreateChatClick"
                    styleClass="btn-create"
                    prefWidth="38" prefHeight="38"/>
            <Button text="+" onAction="#onAddMemberClick"
                    styleClass="btn-secondary"
                    prefWidth="38" prefHeight="38"/>
            <Button text="Профиль" onAction="#onProfileClick"
                    styleClass="btn-secondary" prefHeight="38"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Выйти" onAction="#onLogoutClick"
                    styleClass="btn-logout" prefHeight="38"/>
        </HBox>
    </VBox>

    <!-- ═══ ПРАВАЯ ПАНЕЛЬ — чат ═══ -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #1e1e1e;">

        <!-- Заголовок чата -->
        <HBox alignment="CENTER_LEFT" prefHeight="58.0"
              style="-fx-background-color: #252525; -fx-padding: 0 20 0 20; -fx-border-color: #333; -fx-border-width: 0 0 1 0;">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label fx:id="chatNameLabel" text="Выберите чат"
                       style="-fx-text-fill: #ffffff; -fx-font-weight: bold; -fx-font-size: 16;"/>
                <Label fx:id="chatInfoLabel" text=""
                       style="-fx-text-fill: #888; -fx-font-size: 12;"/>
            </VBox>
            <Button text=" Участники" onAction="#onViewMembersClick"
                    styleClass="btn-secondary" prefHeight="32"/>
        </HBox>

        <!-- Список сообщений -->
        <ListView fx:id="messageListView" VBox.vgrow="ALWAYS"
                  style="-fx-background-color: #1e1e1e; -fx-border-color: transparent;"/>

        <!-- Поле ввода -->
        <HBox spacing="10" prefHeight="65.0" alignment="CENTER"
              style="-fx-padding: 10 15 10 15; -fx-background-color: #252525; -fx-border-color: #333; -fx-border-width: 1 0 0 0;">
            <TextField fx:id="messageInputField" HBox.hgrow="ALWAYS"
                       promptText="Напишите сообщение..."
                       styleClass="text-field"/>
            <Button onAction="#onSendMessageClick" text="➤ Отправить"
                    styleClass="btn-primary" prefHeight="40"/>
        </HBox>
    </VBox>
</HBox>
