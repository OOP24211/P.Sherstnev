<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="15.0" style="-fx-background-color: #1e1e1e;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.example.ui.CreateChatController">
    <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

    <Label text="Название группового чата"
           style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14;"/>

    <TextField fx:id="nameField" promptText="Например: Проект Альфа..."
               styleClass="text-field" maxWidth="260"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Создать" onAction="#onCreateClick" styleClass="btn-create" prefWidth="100" prefHeight="36"/>
        <Button text="Отмена"  onAction="#onCancelClick" styleClass="btn-secondary" prefWidth="100" prefHeight="36"/>
    </HBox>
</VBox>
